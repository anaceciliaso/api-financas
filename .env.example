# Copie este arquivo para .env e troque os valores.
# O .env NUNCA vai para o repositório (está no .gitignore).

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=api_financas

# Use uma frase longa e aleatória. Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_frase_longa_e_dificil_de_adivinhar

# Fuso usado para "hoje" (mês corrente, fatura atual, saúde financeira)
TZ=America/Sao_Paulo
